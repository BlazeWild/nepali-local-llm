LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local
# Use the complete Hugging Face identifier. Change both MODEL_ID and LLM_MODEL together.
# E2B (default): google/gemma-4-E2B-it-qat-q4_0-gguf:Q4_0
# E4B:           google/gemma-4-E4B-it-qat-q4_0-gguf:Q4_0
# 12B:            google/gemma-4-12B-it-qat-q4_0-gguf:Q4_0
MODEL_ID=google/gemma-4-E2B-it-qat-q4_0-gguf:Q4_0
LLM_MODEL=google/gemma-4-E2B-it-qat-q4_0-gguf:Q4_0
USE_CPU=true
GPU_LAYERS=99
REQUEST_TIMEOUT_SECONDS=180
DEFAULT_TEMPERATURE=1.0
DEFAULT_TOP_P=0.95
DEFAULT_TOP_K=64
DEFAULT_MAX_TOKENS=512
MAX_QUEUE_SIZE=50
